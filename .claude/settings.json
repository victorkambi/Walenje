{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./**/local.properties)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "enabledPlugins": {
    "kotlin-agent-skills@Kotlin": true,
    "android-skills@android-skills": true,
    "koin@koin-skills": true
  },
  "extraKnownMarketplaces": {
    "Kotlin": {
      "source": {
        "source": "settings",
        "name": "Kotlin",
        "plugins": [
          {
            "name": "kotlin-agent-skills",
            "source": {
              "source": "github",
              "repo": "Kotlin/kotlin-agent-skills",
              "sha": "087f5689c1934135ed58718cdf524525e452b7e9"
            },
            "description": "JetBrains Kotlin tooling skills.",
            "strict": false
          }
        ]
      }
    },
    "android-skills": {
      "source": {
        "source": "settings",
        "name": "android-skills",
        "plugins": [
          {
            "name": "android-skills",
            "source": {
              "source": "github",
              "repo": "android/skills",
              "sha": "6daa53ef27fa2aa87827d183a85c06cedceca833"
            },
            "description": "Android skills."
          }
        ]
      }
    },
    "koin-skills": {
      "source": {
        "source": "settings",
        "name": "koin-skills",
        "plugins": [
          {
            "name": "koin",
            "source": {
              "source": "github",
              "repo": "InsertKoinIO/koin-skills",
              "sha": "dbe42cd11c43bef27b6267a3329a52eb23e7f669"
            },
            "description": "Official Koin skills: setup, writing Koin code, DI migration and diagnostics."
          }
        ]
      }
    }
  }
}
